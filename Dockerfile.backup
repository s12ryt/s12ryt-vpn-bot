FROM golang:1.26-bookworm AS backup-build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/backup ./cmd/backup \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/restore ./cmd/restore

FROM postgres:17.6-bookworm
COPY --from=backup-build /out/backup /usr/local/bin/backup
COPY --from=backup-build /out/restore /usr/local/bin/restore
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/backup"]
